{
  "name": "signal-path",
  "version": "4.9.9",
  "description": "Local-first notes and planning suite",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "local.signalpath.app",
    "productName": "Signal Path",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "renderer.js",
      "gym.js",
      "calendar.js",
      "canvas.js",
      "theme-init.js",
      "boss-stone.svg",
      "boss-wall.jpg",
      "icon.png"
    ],
    "win": {
      "target": "portable",
      "icon": "icon.ico"
    }
  }
}